{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic change evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "revision",
    "surfaces",
    "instructions",
    "skills",
    "contract",
    "scenarios",
    "commands",
    "review",
    "completion"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "issue": {"type": "string", "pattern": "^#[0-9]+$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "surfaces": {"$ref": "#/$defs/nonemptyStrings"},
    "instructions": {"$ref": "#/$defs/nonemptyStrings"},
    "skills": {"$ref": "#/$defs/nonemptyStrings"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative_inputs",
        "authoritative_output",
        "scope_as_of",
        "governing_policy",
        "evidence_retained",
        "typed_failures"
      ],
      "properties": {
        "authoritative_inputs": {"$ref": "#/$defs/nonemptyString"},
        "authoritative_output": {"$ref": "#/$defs/nonemptyString"},
        "scope_as_of": {"$ref": "#/$defs/nonemptyString"},
        "governing_policy": {"$ref": "#/$defs/nonemptyString"},
        "evidence_retained": {"$ref": "#/$defs/nonemptyString"},
        "typed_failures": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "disposition", "evidence", "rationale"],
        "properties": {
          "id": {
            "enum": [
              "empty_missing_unknown",
              "multiplicity_conflict",
              "scope_time",
              "numeric_boundaries",
              "unsupported_malformed",
              "public_artifact",
              "safe_counterexample"
            ]
          },
          "disposition": {"enum": ["applicable", "not_applicable"]},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/nonemptyString"}},
          "rationale": {"type": "string"}
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "outcome", "evidence"],
        "properties": {
          "argv": {"$ref": "#/$defs/nonemptyStrings"},
          "outcome": {"enum": ["passed", "failed", "skipped"]},
          "evidence": {"$ref": "#/$defs/nonemptyString"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "mode", "findings", "unresolved_findings"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "mode": {"enum": ["self_fresh_pass", "independent_fresh_context"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/nonemptyString"}},
        "unresolved_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonemptyString"}
        }
      }
    },
    "completion": {"enum": ["ready", "not_ready"]}
  },
  "$defs": {
    "nonemptyString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonemptyString"}
    }
  }
}
